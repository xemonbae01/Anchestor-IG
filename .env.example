# copy this to .env and fill in what you use. .env is git-ignored, never commit it.
# env vars always win over config.json.

# mongodb connection string (Atlas free tier works fine, see README > MongoDB)
MONGODB_URI=
# database name inside the cluster, defaults to "anchestor"
MONGODB_DB=anchestor

# instagram session, alternative to account.txt (raw cookie string)
IG_COOKIE_STRING=
# or the three cookies separately
IG_SESSION_ID=
IG_CSRF_TOKEN=
IG_USER_ID=
